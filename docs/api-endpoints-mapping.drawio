          <mxGeometry x="450" y="490" width="180" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="db-emailtemplate-header" value="EmailTemplate" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#82b366;fontColor=#000000;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="450" y="490" width="180" height="25" as="geometry"/>
        </mxCell>
        <mxCell id="db-emailtemplate-fields" value="• 부서별 이메일 양식&#xa;• 자동 발송 설정&#xa;• 승인 필요 여부 관리&#xa;&#xa;연결: department 기반 매칭" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;" vertex="1" parent="1">
          <mxGeometry x="460" y="525" width="160" height="75" as="geometry"/>
        </mxCell>
        
        <!-- RequestSubmission Table Box -->
        <mxCell id="db-requestsubmission-box" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="650" y="490" width="180" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="db-requestsubmission-header" value="RequestSubmission" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#b85450;fontColor=#ffffff;strokeColor=#b85450;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="650" y="490" width="180" height="25" as="geometry"/>
        </mxCell>
        <mxCell id="db-requestsubmission-fields" value="• 의뢰 상신 기록&#xa;• 부서별 의뢰 내역&#xa;• 페이지네이션 지원&#xa;&#xa;연결: submitted_by → 사용자" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;" vertex="1" parent="1">
          <mxGeometry x="660" y="525" width="160" height="75" as="geometry"/>
        </mxCell>
        
        <!-- EmpApprovalRole Table Box -->
