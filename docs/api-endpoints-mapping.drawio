          <mxGeometry x="850" y="490" width="180" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="db-empapprovalrole-header" value="EmpApprovalRole" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#6c8ebf;fontColor=#ffffff;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="850" y="490" width="180" height="25" as="geometry"/>
        </mxCell>
        <mxCell id="db-empapprovalrole-fields" value="• 직원별 결재 역할&#xa;• 결재/합의/통보 구분&#xa;• 병렬 처리 지원&#xa;&#xa;연결: emp_id ← EmpInfo" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;" vertex="1" parent="1">
          <mxGeometry x="860" y="525" width="160" height="75" as="geometry"/>
        </mxCell>
        
        <!-- Relationship Arrow -->
        <mxCell id="relationship-arrow" value="" style="endArrow=classic;html=1;rounded=0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#d79b00;strokeWidth=3;" edge="1" parent="1" source="db-empinfo-box" target="db-empapprovalrole-box">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="590" y="600" as="sourcePoint"/>
