        <mxCell id="approval-header" value="🔄 Approval Role APIs" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#6c8ebf;fontColor=#ffffff;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="430" y="260" width="370" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="approval-content" value="GET /api/approval-roles → EmpApprovalRole ✓&#xa;  (필터: ?department={dept})&#xa;POST /api/approval-roles → EmpApprovalRole ✓&#xa;PUT /api/approval-roles → EmpApprovalRole ✓&#xa;DELETE /api/approval-roles → EmpApprovalRole ✓&#xa;&#xa;사용 페이지:&#xa;• Settings/ApprovalPaths (결재 경로 관리)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontFamily=Courier New;" vertex="1" parent="1">
