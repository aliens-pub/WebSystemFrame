<mxfile host="app.diagrams.net" modified="2025-01-26T02:50:00.000Z" agent="5.0" etag="xxx" version="xx.x.x" type="device">
  <diagram name="API Endpoints Mapping" id="api-endpoints-mapping">
    <mxGraphModel dx="1422" dy="794" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        
        <!-- API Categories Header -->
        <mxCell id="api-title" value="🔗 API Endpoints & Database Mapping" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontStyle=1;fontSize=18;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1089" height="40" as="geometry"/>
        </mxCell>
        
        <!-- Authentication APIs -->
        <mxCell id="auth-section" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="40" y="80" width="340" height="160" as="geometry"/>
        </mxCell>
        <mxCell id="auth-header" value="🔐 Authentication APIs" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#9673a6;fontColor=#ffffff;strokeColor=#9673a6;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="80" width="340" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="auth-content" value="POST /api/auth/login → Employee ✓&#xa;GET /api/auth/me → Employee ✓&#xa;POST /api/auth/logout → Session 관리&#xa;&#xa;사용 페이지:&#xa;• 모든 페이지 (Header 컴포넌트)&#xa;• Dashboard, Admin (권한 확인)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontFamily=Courier New;" vertex="1" parent="1">
          <mxGeometry x="50" y="120" width="320" height="110" as="geometry"/>
        </mxCell>
        
        <!-- Employee Management APIs -->
        <mxCell id="employee-section" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="400" y="80" width="340" height="160" as="geometry"/>
        </mxCell>
        <mxCell id="employee-header" value="👥 Employee Management APIs" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d6b656;fontColor=#000000;strokeColor=#d6b656;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="400" y="80" width="340" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="employee-content" value="GET /api/employees → Employee ✓&#xa;GET /api/emp-info → EmpInfo ✓&#xa;PUT /api/employees/update-roles → Employee ✓&#xa;GET /api/admin/users → Employee ✓&#xa;PUT /api/admin/users/{id}/role → Employee ✓&#xa;&#xa;사용 페이지:&#xa;• Menu1, Menu2 (직원/부서 목록)&#xa;• Admin, Settings (사용자 관리)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontFamily=Courier New;" vertex="1" parent="1">
          <mxGeometry x="410" y="120" width="320" height="110" as="geometry"/>
        </mxCell>
        
        <!-- Request Management APIs -->
        <mxCell id="request-section" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="760" y="80" width="370" height="160" as="geometry"/>
        </mxCell>
        <mxCell id="request-header" value="📋 Request Management APIs" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#b85450;fontColor=#ffffff;strokeColor=#b85450;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="760" y="80" width="370" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="request-content" value="GET /api/request-submissions → RequestSubmission ✓&#xa;POST /api/request-submissions → RequestSubmission ✓&#xa;  (페이지네이션: ?page=1&amp;page_size=10)&#xa;&#xa;사용 페이지:&#xa;• Menu1 (의뢰 목록 조회 - 최신순 정렬)&#xa;• Menu2 (새 의뢰 상신)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontFamily=Courier New;" vertex="1" parent="1">
          <mxGeometry x="770" y="120" width="350" height="110" as="geometry"/>
        </mxCell>
        
        <!-- Email Template APIs -->
        <mxCell id="email-section" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="40" y="260" width="370" height="160" as="geometry"/>
        </mxCell>
        <mxCell id="email-header" value="✉️ Email Template APIs" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#82b366;fontColor=#000000;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="260" width="370" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="email-content" value="GET /api/email-templates → EmailTemplate ✓&#xa;GET /api/email-templates/{dept} → EmailTemplate ✓&#xa;POST /api/email-templates → EmailTemplate ✓&#xa;PUT /api/email-templates/{dept} → EmailTemplate ✓&#xa;&#xa;사용 페이지:&#xa;• Menu2 (부서별 템플릿 로드)&#xa;• Settings/RequestForms (템플릿 관리)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontFamily=Courier New;" vertex="1" parent="1">
          <mxGeometry x="50" y="300" width="350" height="110" as="geometry"/>
        </mxCell>
        
        <!-- Approval Role APIs -->
