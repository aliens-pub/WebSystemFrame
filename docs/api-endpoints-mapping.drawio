        <!-- Employee Table Box -->
        <mxCell id="db-employee-box" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="50" y="490" width="180" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="db-employee-header" value="Employee" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#9673a6;fontColor=#ffffff;strokeColor=#9673a6;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="50" y="490" width="180" height="25" as="geometry"/>
        </mxCell>
        <mxCell id="db-employee-fields" value="• 사용자 인증 (로그인)&#xa;• 권한 관리 (ENGINEER/MANAGER)&#xa;• 관리자 기능 제어&#xa;&#xa;연결: 세션 기반 인증" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;" vertex="1" parent="1">
          <mxGeometry x="60" y="525" width="160" height="75" as="geometry"/>
        </mxCell>
        
        <!-- EmpInfo Table Box -->
        <mxCell id="db-empinfo-box" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="250" y="490" width="180" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="db-empinfo-header" value="EmpInfo" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d6b656;fontColor=#000000;strokeColor=#d6b656;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="250" y="490" width="180" height="25" as="geometry"/>
        </mxCell>
        <mxCell id="db-empinfo-fields" value="• 직원 상세 정보&#xa;• 부서별 조직도&#xa;• 의뢰 대상 부서 목록&#xa;&#xa;연결: emp_id → EmpApprovalRole" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;" vertex="1" parent="1">
          <mxGeometry x="260" y="525" width="160" height="75" as="geometry"/>
